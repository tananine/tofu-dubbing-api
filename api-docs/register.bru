meta {
  name: register
  type: http
  seq: 9
}

post {
  url: {{url}}/api/auth/register
  body: json
  auth: inherit
}

body:json {
  {
    "email": "test@test.com",
    "password": "Test1234!"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  # Register
  
  Create a new user account.
  
  ## Endpoint
  POST /api/auth/register
  
  ## Authentication
  Not required
  
  ## Request Body
  ```json
  {
    "email": "user@example.com",
    "password": "yourpassword"
  }
  ```
  
  ## Validation Rules
  - **email**: Valid email format, max 80 characters, not already exist in the system
  - **password**: Must be 8-16 characters
  
  ## Response (201 Created)
  ```json
  {
    "id": 3,
    "email": "user@example.com",
    "createdAt": "2026-01-19T07:07:38.412Z",
    "updatedAt": "2026-01-19T07:07:38.412Z"
  }
  ```
  
  ## Error Responses
  - **409 Conflict**: `{ "message": "emailAlreadyExists" }` - Email already registered
  - **400 Bad Request**: Validation errors (invalid email, email too long, password length not 8-16)
  
  ## Use Cases
  - New user sign up
  - After successful registration, redirect user to login page
  
  ## Notes
  - Password is hashed with bcrypt (10 rounds) before storage
  - Password is never returned in responses
}

example {
  name: example
  
  request: {
    url: https://tofu-dubbing-api.dolishco.com/api/auth/register
    method: POST
    mode: json
    body:json: {
      {
        "email": "test@test.com",
        "password": "Test1234!"
      }
    }
  }
  
  response: {
    headers: {
      access-control-allow-credentials: true
      access-control-allow-origin: *
      access-control-expose-headers: *
      alt-svc: h3=":443"; ma=2592000
      content-length: 110
      content-type: application/json; charset=utf-8
      date: Mon, 19 Jan 2026 07:07:38 GMT
      etag: W/"6e-XAyUpnsKUTZxbjVLZoWg4sKUII8"
      via: 1.1 Caddy
      x-powered-by: Express
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        {
          "id": 3,
          "email": "test@test.com",
          "createdAt": "2026-01-19T07:07:38.412Z",
          "updatedAt": "2026-01-19T07:07:38.412Z"
        }
      '''
    }
  }
}
