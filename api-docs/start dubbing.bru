meta {
  name: start dubbing
  type: http
  seq: 17
}

post {
  url: https://tofu-dubbing-api.dolishco.com/api/dubbing/start
  body: json
  auth: inherit
}

body:json {
  {
    "sourceLanguage": "auto (en)",
    "targetLanguage": "th-TH",
    "pageUrl": "https://www.youtube.com/watch?v=VIDEO_ID"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  # Start Dubbing Session
  
  Initialize a dubbing session before starting playback. Logs the language pair, optional page URL, and checks Pro subscription status. The extension calls this after a caption track is selected so `sourceLanguage` can be `auto (<lang>)` when the user chose auto-detect.
  
  ## Endpoint
  POST /api/dubbing/start
  
  ## Authentication
  **Required** - Must include Bearer token in Authorization header
  
  ## Request Body
  ```json
  {
    "sourceLanguage": "auto (en)",
    "targetLanguage": "th-TH",
    "pageUrl": "https://www.youtube.com/watch?v=VIDEO_ID"
  }
  ```
  
  - `sourceLanguage`: Fixed source language code, or when the user setting is auto, `auto (<primary>)` where `<primary>` is the BCP 47 primary subtag from the selected caption track (e.g. `auto (en)`, `auto (th)`, `auto (ja)`)
  - `targetLanguage`: Target language/voice locale (e.g. `"th-TH"`, `"en-US"`)
  - `pageUrl` (optional): Page URL where dubbing was started (e.g. watch URL)
  
  ## Description
  Must be called once before each dubbing session starts (after subtitles/tracks are resolved). Records:
  - Which language pair the user is dubbing (source → target)
  - Optional page URL for analytics
  - Whether the user is Pro at the time of session start
  
  ## Response (201 Created)
  ```json
  {
    "isPro": false
  }
  ```
  
  - `isPro`: Whether the authenticated user has an active Pro subscription
  
  ## Error Responses
  - **401 Unauthorized**: Missing or invalid token
  - **400 Bad Request**: Missing or invalid sourceLanguage / targetLanguage
  
  ## Use Cases
  - Called by the extension after a caption track is chosen for the video
  - Returns Pro status for the session (also stored in the dubbing log)
  - Enables analytics on language pair and page URL per user
}

example {
  name: example
  
  request: {
    url: https://tofu-dubbing-api.dolishco.com/api/dubbing/start
    method: POST
    mode: json
    body:json: {
      {
        "sourceLanguage": "auto (en)",
        "targetLanguage": "th-TH",
        "pageUrl": "https://www.youtube.com/watch?v=VIDEO_ID"
      }
    }
  }
  
  response: {
    headers: {
      access-control-allow-credentials: true
      access-control-allow-origin: *
      access-control-expose-headers: *
      content-type: application/json; charset=utf-8
      via: 1.1 Caddy
      x-powered-by: Express
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        {
          "isPro": false
        }
      '''
    }
  }
}
